{
    "name": "@eventjet/react-seatmaps",
    "version": "2.0.2",
    "description": "React components for rendering Eventjet seatmaps",
    "license": "MIT",
    "author": {
        "name": "Rudolph Gottesheim",
        "email": "r.gottesheim@loot.at"
    },
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "api": "api-extractor run --local",
        "api:check": "api-extractor run",
        "build": "tsdown",
        "build-storybook": "storybook build",
        "ch": "pnpm lint && pnpm typecheck && pnpm test && pnpm api:check",
        "clean": "rm -rf dist",
        "dev": "tsdown --watch",
        "lint": "eslint src",
        "storybook": "storybook dev -p 6006",
        "test": "vitest run",
        "test:e2e": "playwright test --config playwright.config.ts",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/plugin-syntax-jsx": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@emotion/react": "^11.10.0",
        "@emotion/styled": "^11.10.0",
        "@eslint/js": "^10.0.1",
        "@microsoft/api-extractor": "^7.58.12",
        "@playwright/test": "^1.62.0",
        "@storybook/react": "^10.5.10",
        "@storybook/react-vite": "^10.5.10",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^10.9.1",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "storybook": "^10.5.10",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@emotion/react": "^11.10.0",
        "@emotion/styled": "^11.10.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
